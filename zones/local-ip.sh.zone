; Zone file of the production instance, origin local-ip.sh.
; xip-staging.local-ip.sh is served by the staging instance (Fly app local-ip-staging).
; A delegation takes every name below its label away from this instance, including names that
; carry an address: 10-0-0-1.staging.local-ip.sh is a name of the service. Only labels that start
; with xip-, which are reserved for the project, may be delegated here.
xip-staging      NS  ns1.xip-staging
ns1.xip-staging  A   149.248.203.129
; Mail for the domain is handled by mail.mial.net; the DKIM selectors are that server's keys for this domain.
@                   MX     10 mail.mial.net.
@                   TXT    "v=spf1 mx -all"
202411e._domainkey  TXT    "v=DKIM1; k=ed25519; h=sha256; p=Xic3wKt0G+05OJw4q9U5FImcGnvKcMK5chBgYljJv8c="
202411r._domainkey  TXT    "v=DKIM1; k=rsa; h=sha256; p=MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA2y9b1q/Of6doBMq4f16YJkM9BSMAdiNCyQhy1BcEVG9XpIObaJzhRWddhAPB6Awz/QqnCkx51AXuMDgKIsv2Cs87+jJoILdJ2T6HhS05kZj5FHBKMNctgcFzN2XRhXXpIVLWbA9Ef7takTa2AO5+qCT0M1xkumNQEXc/znTuaWS86e766hLA06a" "7pBwriJj4ceb5V6/q5fvfVq+EgJnk8WQ9DQRs4VjHaSVN0fscRzzJsZAQpa6KqmSLiXzM+NktGN40EZGqFrvvGcfdE+jEa++rePixXgKsETZCR32tKCNCELzbdTGchu01F6vZVxT/AGNfxzFWs9tuXdiltYmhbwIDAQAB"
_dmarc              TXT    "v=DMARC1; p=reject; rua=mailto:postmaster@local-ip.sh"
_smtp._tls          TXT    "v=TLSRPTv1; rua=mailto:postmaster@local-ip.sh"
